<Project>
  <!-- Import the root props first -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Prevent BenchmarkDotNet's autogenerated project (built under bin/) from trying to pack,
       which would fail because icon.png is not reachable from the deep output path. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
