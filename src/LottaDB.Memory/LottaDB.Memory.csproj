<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Lotta</RootNamespace>
    <Description>In-memory storage provider for LottaDB. Adds UseMemory() extension method for fast unit testing with no disk I/O.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>lottadb;azure;table-storage;lucene;memory;testing</PackageTags>
    <Version>5.0.0</Version>
    <AssemblyVersion>5.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LottaDB\LottaDB.csproj" />
    <PackageReference Include="Iciclecreek.Azure.Storage.Memory" Version="2.0.3" />
  </ItemGroup>

</Project>
