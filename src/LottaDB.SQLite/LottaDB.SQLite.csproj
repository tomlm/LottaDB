<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Lotta</RootNamespace>
    <Description>SQLite storage provider for LottaDB. Adds UseSQLite() extension method for local development with a single portable .db file.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>lottadb;azure;table-storage;lucene;sqlite;local</PackageTags>
    <Version>5.0.0</Version>
    <AssemblyVersion>5.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LottaDB\LottaDB.csproj" />
    <PackageReference Include="Iciclecreek.Azure.Storage.SQLite" Version="2.0.4" />
  </ItemGroup>

</Project>
